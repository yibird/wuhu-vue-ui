{
  "name": "@wuhu-vue-ui/lazy-container",
  "version": "0.1.0",
  "description": "IntersectionObserver powered lazy container for Vue 3.",
  "keywords": [
    "component",
    "ui",
    "vue",
    "vue3"
  ],
  "license": "MIT",
  "style": "./dist/style.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.node.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
