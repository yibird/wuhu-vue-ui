{
  "name": "@wuhu-vue-ui/file-viewer",
  "version": "0.0.1",
  "description": "A themeable, internationalized file preview component for Vue 3.",
  "keywords": [
    "document-viewer",
    "docx",
    "epub",
    "file-preview",
    "file-viewer",
    "pdf",
    "pptx",
    "vue",
    "xlsx"
  ],
  "homepage": "https://github.com/yibird/wuhu-vue-ui#readme",
  "bugs": {
    "url": "https://github.com/yibird/wuhu-vue-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yibird/wuhu-vue-ui.git"
  },
  "funding": "https://github.com/sponsors/yibird",
  "style": "./dist/style.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.node.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@wuhu-vue-ui/core": "workspace:*",
    "@wuhu-vue-ui/empty": "workspace:*",
    "@wuhu-vue-ui/tooltip": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  }
}
