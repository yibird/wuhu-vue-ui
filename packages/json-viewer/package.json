{
  "name": "@wuhu-vue-ui/json-viewer",
  "version": "0.0.1",
  "description": "Read-only, auto-formatted JSON viewer built on CodeEditor and Monaco.",
  "keywords": [
    "component",
    "json",
    "json-viewer",
    "ui",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/yibird/wuhu-vue-ui#readme",
  "bugs": {
    "url": "https://github.com/yibird/wuhu-vue-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yibird/wuhu-vue-ui.git"
  },
  "funding": "https://github.com/sponsors/yibird",
  "style": "./dist/style.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.node.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@wuhu-vue-ui/code-editor": "workspace:*"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.40.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  }
}
