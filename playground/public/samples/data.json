{
  "name": "wuhu-file-viewer",
  "version": "0.0.1",
  "private": false,
  "features": {
    "lazyRenderers": true,
    "formats": 48,
    "themes": ["light", "dark", "custom"],
    "locales": ["en", "zh-CN"],
    "pdfjs": {
      "optional": true,
      "fallback": "native-browser-viewer"
    }
  },
  "renderers": [
    { "kind": "image", "chunk": "ImageRenderer", "size": "4.2 kB" },
    { "kind": "document", "chunk": "DocxRenderer", "size": "18.7 kB" },
    { "kind": "spreadsheet", "chunk": "XlsxRenderer", "size": "21.3 kB" },
    { "kind": "presentation", "chunk": "PptxRenderer", "size": "19.9 kB" },
    { "kind": "pdf", "chunk": "PdfRenderer", "size": "9.4 kB" }
  ],
  "toolbar": ["zoom", "rotate", "page", "download", "print", "theme", "fullscreen"],
  "lastUpdated": "2026-10-19T00:00:00.000Z"
}
