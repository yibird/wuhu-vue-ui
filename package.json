{
  "name": "wuhu-vue-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm docs:dev",
    "dev:playground": "pnpm --filter @wuhu-vue-ui/playground dev",
    "docs:dev": "vitepress dev docs --port 9191",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:playground": "pnpm --filter @wuhu-vue-ui/playground build",
    "samples:generate": "node scripts/generate-file-viewer-samples.mjs",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p playground/tsconfig.json && vue-tsc --noEmit -p docs/tsconfig.json",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:visual": "node scripts/visual-check.mjs",
    "test:a11y": "node scripts/a11y-check.mjs",
    "test:memory": "node scripts/memory-check.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "antdv-next": "^1.7.0",
    "axe-core": "^4.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "shiki": "2.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-plus": "^1.3.0",
    "vitepress": "1.6.4",
    "vitepress-demo-plugin": "1.8.0",
    "vitepress-plugin-group-icons": "1.8.1",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "vp lint --fix",
      "vp fmt --write"
    ],
    "*.{json,md,yml,yaml,css,less}": [
      "vp fmt --write"
    ]
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.18.1"
}
